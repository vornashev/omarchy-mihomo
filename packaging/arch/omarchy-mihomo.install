post_install() {
  echo '==> As your user (not root), run once:  omarchy-mihomo-setup'
  echo '    It starts the services, fetches the mihomo core, asks sudo to give it'
  echo '    TUN capabilities and adds the Mihomo widget to the bar.'
}

post_upgrade() {
  echo '==> Restart the daemon to use the new version:  systemctl --user restart omarchy-mihomod'
}

pre_remove() {
  echo '==> Per-user parts stay after removal unless you ran  omarchy-mihomo-setup --uninstall  first:'
  echo '    the widget link ~/.config/omarchy/plugins/vornashev.omarchy-mihomo, the core in'
  echo '    ~/.local/lib/omarchy-mihomo and your data in ~/.local/share/omarchy-mihomo.'
  echo '    Stop the services with:  systemctl --user disable --now omarchy-mihomod omarchy-mihomo-core'
}
